# Builder for Ubuntu: the userland builder (KERNEL empty: the shared root
# file system and every reproducer's OpenZFS userland tools) and the builder
# of an Ubuntu target (KERNEL set: its OpenZFS modules, and its kernel in
# /kernel).  builder/build.sh makes it; nothing here is published.
ARG IMAGE
FROM ${IMAGE}
ARG SNAPSHOT
ARG KERNEL=
ENV DEBIAN_FRONTEND=noninteractive LC_ALL=C.UTF-8
COPY in/kernel-stage.sh /usr/local/bin/
# packages come from the Ubuntu snapshot service at SNAPSHOT (needs
# ca-certificates first, from the image's own archive)
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends ca-certificates >/dev/null && \
    printf 'APT::Snapshot "%s";\n' "$SNAPSHOT" >/etc/apt/apt.conf.d/50snapshot && \
    apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends \
	build-essential autoconf automake libtool gawk pkg-config git curl \
	libblkid-dev uuid-dev libudev-dev libssl-dev zlib1g-dev libaio-dev libattr1-dev \
	libelf-dev libtirpc-dev libffi-dev libcurl4-openssl-dev libpam0g-dev python3 \
	busybox-static bash util-linux bsdextrautils mawk binutils e2fsprogs cpio kmod \
	xz-utils zstd qemu-utils diffutils findutils coreutils ncurses-base ncurses-term \
	fdisk file ksh >/dev/null && \
    if [ -n "$KERNEL" ]; then \
	apt-get install -y -qq --no-install-recommends "linux-headers-$KERNEL" >/dev/null && \
	mkdir -p /tmp/k /kernel && cd /tmp/k && \
	apt-get download -qq "linux-image-$KERNEL" "linux-modules-$KERNEL" && \
	for d in *.deb; do dpkg -x "$d" root; dpkg-deb -f "$d" Package Version Source | tr '\n' ' '; echo; done >/kernel/pkg.txt && \
	kernel-stage.sh "$KERNEL" /tmp/k/root "/usr/src/linux-headers-$KERNEL" "/usr/src/linux-headers-$KERNEL" && \
	cd / && rm -rf /tmp/k; \
    fi && rm -rf /var/lib/apt/lists/*
